<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hilo_widget_bg_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/compact_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/compact_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Hilo"
            android:textColor="#A1A1AA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/compact_streak_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0d"
            android:textColor="#3CD08B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/compact_weekly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="0/7 esta semana"
            android:textColor="#F5F5F4"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/compact_week_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:contentDescription="Progreso de esta semana"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/compact_action_btn"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/hilo_widget_pill_btn_bg"
        android:gravity="center"
        android:text="+ Registrar"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
