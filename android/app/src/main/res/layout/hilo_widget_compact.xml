<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/compact_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Fondo de estado de racha"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_active" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/compact_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/compact_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Hilo"
                android:textColor="#E4E4E7"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/compact_streak_big"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0d"
                android:textColor="#3CD08B"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/compact_status_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Empieza hoy tu hilo"
                android:textColor="#F5F5F4"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/compact_week_bar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:contentDescription="Progreso de esta semana"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/compact_action_btn"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@drawable/hilo_widget_pill_btn_bg"
            android:gravity="center"
            android:text="+ Registrar"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
