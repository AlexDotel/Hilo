<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hilo_widget_bg_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/exp_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hilo"
                android:textColor="#F5F5F4"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exp_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoy 0/0 · 0% (30d)"
                android:textColor="#A1A1AA"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/exp_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hilo_widget_badge_bg"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:text="0d"
            android:textColor="#3CD08B"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/exp_heatmap_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:contentDescription="Mapa de calor de hábitos"
        android:scaleType="fitCenter" />

    <!-- Row 1 -->
    <LinearLayout
        android:id="@+id/exp_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/exp_check_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text="○"
            android:textColor="#3CD08B"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/exp_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F5F5F4"
            android:textSize="13.5sp" />
        <TextView
            android:id="@+id/exp_progress_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A1A1AA"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:id="@+id/exp_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/exp_check_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text="○"
            android:textColor="#3CD08B"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/exp_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F5F5F4"
            android:textSize="13.5sp" />
        <TextView
            android:id="@+id/exp_progress_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A1A1AA"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:id="@+id/exp_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/exp_check_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text="○"
            android:textColor="#3CD08B"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/exp_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F5F5F4"
            android:textSize="13.5sp" />
        <TextView
            android:id="@+id/exp_progress_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A1A1AA"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout
        android:id="@+id/exp_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/exp_check_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text="○"
            android:textColor="#3CD08B"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/exp_title_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F5F5F4"
            android:textSize="13.5sp" />
        <TextView
            android:id="@+id/exp_progress_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A1A1AA"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Row 5 -->
    <LinearLayout
        android:id="@+id/exp_row_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">
        <TextView
            android:id="@+id/exp_check_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text="○"
            android:textColor="#3CD08B"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/exp_title_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F5F5F4"
            android:textSize="13.5sp" />
        <TextView
            android:id="@+id/exp_progress_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A1A1AA"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
